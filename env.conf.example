# GAVATCORE environment template

# Telegram API credentials
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Admin bot
ADMIN_BOT_TOKEN=

# System bot
GAVATCORE_SYSTEM_PHONE=
GAVATCORE_ADMIN_ID=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Licensing
DEMO_DURATION_MINUTES=180
DEFAULT_LICENSE_DAYS=30

# Paths
DATA_DIR=data
SESSIONS_DIR=sessions
LOGS_DIR=logs

# Runtime flags
USE_DEFAULT_FLIRT_TEMPLATES=True
LOG_ALL_MESSAGES=True
ENABLE_GROUP_HANDLERS=True

AUTHORIZED_USERS=
ADMIN_USER_ID=

# MongoDB and Redis
MONGO_URI=mongodb://localhost:27017
MONGO_DATABASE=gavatcore
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600

# Feature flags
FEATURE_CONTACT_MANAGEMENT=true
FEATURE_AUTO_CLEANUP=true
FEATURE_GPT_RESPONSES=true
FEATURE_ANALYTICS=true
FEATURE_ADMIN_COMMANDS=true

# Session and cleanup
SESSION_NAME=gavatcore_session
CLEANUP_INTERVAL_HOURS=6
CLEANUP_MAX_AGE_HOURS=24
CLEANUP_BATCH_SIZE=100
